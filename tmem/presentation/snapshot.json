    "link_bonus": "1 + gamma * (|L_i| / max_j |L_j|)",
    "retrieval_tmem": "score = alpha * cos(e_q, e_i) + (1-alpha) * minmax(r_i)",
    "retrieval_amem": "alpha = 1 => pure cosine (A-MEM Eq. 9 style)"
