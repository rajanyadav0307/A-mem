# Secrets
.env

# Python environments and caches
.venv/
__pycache__/
*.pyc
.cache/
.mplconfig/

# OS files
.DS_Store

# Claude Code local files
.claude/settings.local.json
.claude/worktrees/

# Evaluation logs (logs already committed stay tracked)
logs/*.log

# Memory caches built during evaluation
cached_memories_*/

# Large per-experiment logs and caches (results, notes and question plans stay visible)
experiments/*/logs/
experiments/*/cache/

# Large run logs from failed attempts and trial runs (results and checks stay visible)
experiments/*/invalid/*/*.log
experiments/*/invalid/*/*.stdout
experiments/*/trial/*.log
experiments/*/trial/*.stdout
